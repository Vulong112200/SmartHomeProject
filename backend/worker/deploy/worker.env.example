# Mẫu cấu hình worker Hẹn giờ tại nhà.
# Sao chép thành backend/worker/.env (đã gitignore) và điền giá trị THẬT.
# KHÔNG commit file .env. Quyền file nên là 600: chmod 600 backend/worker/.env

# --- Database: CÙNG Postgres Supabase với backend trên Render ---
# Khuyên dùng role quyền hẹp (deploy/worker_role.sql), username dạng
# smarthome_worker.<project-ref> qua Session pooler (cổng 5432). Không có role
# riêng thì dùng đúng DATABASE_URL đang đặt trên Render.
# Ưu tiên WORKER_DATABASE_URL; không đặt thì dùng DATABASE_URL.
WORKER_DATABASE_URL=postgresql://smarthome_worker.xxxx:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# --- Credential thiết bị (giống backend) ---
TUYA_ACCESS_ID=your-tuya-access-id
TUYA_ACCESS_KEY=your-tuya-access-key
TUYA_API_ENDPOINT=https://openapi-sg.iotbing.com/
VESYNC_EMAIL=your-email@example.com
VESYNC_PASSWORD=your-password

# --- Tùy chọn ---
# Tên hiển thị ở `python -m worker status` (mặc định = hostname).
# WORKER_ID=raspberrypi-phong-khach
# Ghi log ra file xoay vòng (5 MB × 5) ngoài stdout. Bắt buộc nên đặt trên Windows.
# WORKER_LOG_FILE=worker/logs/worker.log
# WORKER_LOG_LEVEL=INFO
# Nhịp quét lịch (5–55 giây, mặc định 30).
# WORKER_TICK_SECONDS=30
