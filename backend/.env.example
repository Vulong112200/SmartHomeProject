# Sao chép file này thành backend/.env và điền giá trị thật.
# Trên Render: set các biến này trong Dashboard > Environment.

# VeSync (máy lọc không khí)
VESYNC_EMAIL=your-email@example.com
VESYNC_PASSWORD=your-password

# Tuya Cloud (cửa cuốn + máy cho ăn Rojeco dùng chung app Tuya)
TUYA_ACCESS_ID=your-tuya-access-id
TUYA_ACCESS_KEY=your-tuya-access-key
TUYA_API_ENDPOINT=https://openapi-sg.iotbing.com/

# OpenRouter (AI parse lệnh giọng nói)
OPENROUTER_API_KEY=your-openrouter-key

# --- Đăng nhập & phân quyền (Phase 1b/2) ---
# Secret JWT của Supabase (Project Settings > API > JWT Settings > JWT Secret).
# CHƯA đặt  -> xác thực TỰ TẮT, mọi request coi như chủ nhà (giai đoạn 1b).
# ĐÃ đặt    -> xác thực tự BẬT, app phải gửi Bearer token.
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Email của chủ nhà, phân tách bằng dấu phẩy. Các email này LUÔN là owner/active
# kể cả khi vai trong DB bị hạ — cứu hộ để không tự khóa mình khỏi nhà mình.
# ADMIN_EMAILS=chunha@example.com

# Ép bật/tắt xác thực, thắng mọi suy diễn ở trên. Để trống là đủ dùng.
#   1 = tắt (dev offline, không cần Supabase)   0 = bật (kể cả khi thiếu secret)
# AUTH_DISABLED=

# Postgres (Supabase). KHÔNG đặt -> tự fallback SQLite local, tiện dev offline.
# Trên Render BẮT BUỘC đặt: ổ đĩa ephemeral làm mất lịch hẹn mỗi lần deploy.
# Phải dùng chuỗi "Session pooler" (IPv4) — Direct connection chỉ có IPv6 mà
# Render free không hỗ trợ. Chi tiết: docs/SUPABASE_SETUP.md
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
